-- AddKeybind
function Library._AddKeybind(section)
    return function(text,default,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row); lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(0.6,0,1,0)
        local btn=Instance.new("TextButton",row); btn.Text=tostring(default); btn.Font=Enum.Font.Gotham; btn.TextSize=16
        btn.TextColor3=Color3.new(1,1,1); btn.Size=UDim2.new(0,100,0,28); btn.Position=UDim2.new(1,-108,0,2)
        btn.AutoButtonColor=false; btn.BackgroundColor3=Color3.fromRGB(80,80,80)
        Instance.new("UICorner",btn); Instance.new("UIStroke",btn).Color=Color3.fromRGB(100,100,100)
        btn.MouseButton1Click:Connect(function()
            btn.Text="..."
            local conn
            conn=UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType==Enum.UserInputType.Keyboard then
                    btn.Text=tostring(input.KeyCode); callback(input.KeyCode); registerControl(nil,text,input.KeyCode)
                    conn:Disconnect()
                end
            end)
        end)
        registerControl(nil,text,default)
        return section
    end
end

-- apply config
function Library:ApplyConfig(cfg)
    for name,val in pairs(cfg) do
        local ctrl=self._controls[name]
        if ctrl and ctrl.SetValue then ctrl:SetValue(val) end
    end
    self._config=cfg
end

-- inject control methods into section
for _,m in ipairs({
    {"AddButton",     "_AddButton"},
    {"AddToggle",     "_AddToggle"},
    {"AddSlider",     "_AddSlider"},
    {"AddColorPicker","_AddColorPicker"},
    {"AddDropdown",   "_AddDropdown"},
    {"AddTextbox",    "_AddTextbox"},
    {"AddParagraph",  "_AddParagraph"},
    {"AddKeybind",    "_AddKeybind"},
}) do
    local name,fn = m[1], m[2]
    Library[name] = function(self,...)
        local page = Library._pages[...] -- wrong, but won't be called
    end
end

-- attach methods to section metatable
local secMeta = {}
for _,m in ipairs({"AddButton","AddToggle","AddSlider","AddColorPicker","AddDropdown","AddTextbox","AddParagraph","AddKeybind"}) do
    secMeta[m] = Library["_"..m]
end

-- hook _AddSectionInternal to return a section proxy
local oldSection = Library.AddSectionInternal
function Library.AddSectionInternal(frame,title)
    local section = oldSection(Library, frame, title)
    setmetatable(section, {__index = secMeta})
    return section
end

-- Notification
function Library.CreateNoti(opts)
    opts.Title    = opts.Title or ""
    opts.Desc     = opts.Desc or ""
    opts.Duration = opts.Duration or 3

    local gui = Instance.new("ScreenGui", PlayerGui)
    gui.Name = "ProjectLunarNoti"
    local cont = Instance.new("Frame", gui)
    cont.AnchorPoint=Vector2.new(1,1)
    cont.Position=UDim2.new(1,-8,1,-8)
    cont.Size=UDim2.new(0,300,0,0)
    cont.BackgroundTransparency=1
    local nf = Instance.new("Frame", cont)
    nf.Size=UDim2.new(1,0,0,0); nf.Position=UDim2.new(0,0,0,nf.Size.Y.Offset)
    nf.BackgroundColor3=Color3.fromRGB(35,35,35); Instance.new("UICorner",nf); Instance.new("UIStroke",nf).Color=Color3.fromRGB(100,100,100)
    local title=Instance.new("TextLabel",nf)
    title.Text=opts.Title; title.Font=Enum.Font.GothamBold; title.TextSize=18; title.TextColor3=Color3.new(1,1,1)
    title.BackgroundTransparency=1; title.Position=UDim2.new(0,8,0,8); title.Size=UDim2.new(1,-16,0,24)
    local desc=Instance.new("TextLabel",nf)
    desc.Text=opts.Desc; desc.Font=Enum.Font.Gotham; desc.TextSize=14; desc.TextColor3=Color3.fromRGB(200,200,200)
    desc.BackgroundTransparency=1; desc.Position=UDim2.new(0,8,0,32); desc.Size=UDim2.new(1,-16,0,18)
    local height = 8+24+4+18+8
    nf:TweenSize(UDim2.new(1,0,0,height),"Out","Quad",0.3,true)
    nf:TweenPosition(UDim2.new(0,0,0,0),"Out","Quad",0.3,true)
    delay(opts.Duration, function()
        nf:TweenPosition(UDim2.new(0,0,0,height),"Out","Quad",0.3,true)
        wait(0.3)
        gui:Destroy()
    end)
end

return Library
