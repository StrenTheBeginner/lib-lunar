-- ProjectLunarUI.lua
-- ModuleScript under ReplicatedStorage

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players          = game:GetService("Players")
local HttpService      = game:GetService("HttpService")
local LocalPlayer      = Players.LocalPlayer
local PlayerGui        = LocalPlayer:WaitForChild("PlayerGui")

local Library = {}
Library._pages    = {}
Library._config   = {}
Library._controls = {}

local function tween(inst, props, dur)
    return TweenService:Create(inst, TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
end

function Library:CreateMain(opts)
    assert(opts.Title, "Title required")
    opts.Desc = opts.Desc or ""
    opts.Icon = opts.Icon or ""

    local screen = Instance.new("ScreenGui", PlayerGui)
    screen.Name = "ProjectLunarUI"
    screen.ResetOnSpawn = false

    local main = Instance.new("Frame", screen)
    main.Name  = "Main"
    main.Size  = UDim2.new(0,640,0,440)
    main.Position = UDim2.new(0.5,-320,0.5,-220)
    main.BackgroundColor3 = Color3.fromRGB(30,30,30)
    Instance.new("UICorner", main).CornerRadius = UDim.new(0,8)
    Instance.new("UIStroke", main).Color = Color3.fromRGB(100,100,100)
    self._main = main

    local titleBar = Instance.new("Frame", main)
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1,0,0,48)
    titleBar.BackgroundTransparency = 1

    local icon = Instance.new("ImageLabel", titleBar)
    icon.Name = "Icon"
    icon.Size = UDim2.new(0,32,0,32)
    icon.Position = UDim2.new(0,12,0,8)
    icon.BackgroundTransparency = 1
    icon.Image = opts.Icon

    local titleLbl = Instance.new("TextLabel", titleBar)
    titleLbl.Text = opts.Title
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 22
    titleLbl.TextColor3 = Color3.new(1,1,1)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0,52,0,8)
    titleLbl.Size = UDim2.new(0,300,0,24)

    local descLbl = Instance.new("TextLabel", titleBar)
    descLbl.Text = opts.Desc
    descLbl.Font = Enum.Font.Gotham
    descLbl.TextSize = 14
    descLbl.TextColor3 = Color3.fromRGB(180,180,180)
    descLbl.BackgroundTransparency = 1
    descLbl.Position = UDim2.new(0,52,0,30)
    descLbl.Size = UDim2.new(0,300,0,14)

    do  -- draggable
        local dragging, start, initPos
        titleBar.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then
                dragging=true
                start = i.Position
                initPos = main.Position
                i.Changed:Connect(function()
                    if i.UserInputState==Enum.UserInputState.End then dragging=false end
                end)
            end
        end)
        titleBar.InputChanged:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseMovement then
                UserInputService.InputChanged:Connect(function(move)
                    if dragging and move==i then
                        local delta = move.Position - start
                        main.Position = UDim2.new(
                            initPos.X.Scale, initPos.X.Offset+delta.X,
                            initPos.Y.Scale, initPos.Y.Offset+delta.Y
                        )
                    end
                end)
            end
        end)
    end

    local sidebar = Instance.new("Frame", main)
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0,120,1,-48)
    sidebar.Position = UDim2.new(0,0,0,48)
    sidebar.BackgroundTransparency = 1
    Instance.new("UIListLayout", sidebar).Padding = UDim.new(0,4)
    self._sidebar = sidebar

    local content = Instance.new("Frame", main)
    content.Name = "Content"
    content.Size = UDim2.new(1,-120,1,-48)
    content.Position = UDim2.new(0,120,0,48)
    content.BackgroundTransparency = 1
    self._content = content

    self:AddPage("Config")
    local cfg = self._pages["Config"]
    cfg.Section:AddButton("Copy Config", function()
        local json = HttpService:JSONEncode(self._config)
        if setclipboard then setclipboard(json) end
    end)
    cfg.Section:AddTextbox("Import Config", "", function(txt)
        local ok,data = pcall(HttpService.JSONDecode, HttpService, txt)
        if ok then self:ApplyConfig(data) end
    end)
end

function Library:AddPage(name)
    local btn = Instance.new("TextButton", self._sidebar)
    btn.Text = name
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(200,200,200)
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1,0,0,32)

    local frame = Instance.new("Frame", self._content)
    frame.Name = name
    frame.Size = UDim2.new(1,0,1,0)
    frame.BackgroundTransparency = 1
    frame.Visible = false

    local section = {}
    function section:AddButton(text, cb)
        local b=Instance.new("TextButton", frame)
        b.Text=text; b.Font=Enum.Font.Gotham; b.TextSize=16; b.TextColor3=Color3.new(1,1,1)
        b.BackgroundColor3=Color3.fromRGB(80,80,80); b.Size=UDim2.new(1,0,0,32)
        Instance.new("UICorner",b); Instance.new("UIStroke",b).Color=Color3.fromRGB(100,100,100)
        b.MouseEnter:Connect(function() tween(b,{BackgroundColor3=Color3.fromRGB(100,100,100)}) end)
        b.MouseLeave:Connect(function() tween(b,{BackgroundColor3=Color3.fromRGB(80,80,80)}) end)
        b.MouseButton1Click:Connect(cb)
        return section
    end
    function section:AddToggle(text, default, cb)
        local row=Instance.new("Frame", frame)
        row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row)
        lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(0.7,0,1,0)
        local sw=Instance.new("Frame",row)
        sw.Size=UDim2.new(0,50,0,28); sw.Position=UDim2.new(1,-58,0,2)
        sw.BackgroundColor3=Color3.fromRGB(80,80,80); Instance.new("UICorner",sw)
        local knob=Instance.new("Frame",sw)
        knob.Size=UDim2.new(0,24,1,0); knob.Position=UDim2.new(default and 1 or 0, default and -24 or 0,0,0)
        knob.BackgroundColor3=Color3.new(1,1,1); Instance.new("UICorner",knob)
        local state=default
        sw.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then
                state=not state
                tween(knob,{Position=UDim2.new(state and 1 or 0,state and -24 or 0,0,0)})
                cb(state)
            end
        end)
        return section
    end
    function section:AddSlider(text, default, range, cb)
        local row=Instance.new("Frame", frame)
        row.Size=UDim2.new(1,0,0,48); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row)
        lbl.Text=text.." ("..default..")"; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(1,0,0,20)
        local bar=Instance.new("Frame",row)
        bar.Position=UDim2.new(0,0,0,24); bar.Size=UDim2.new(1,0,0,8)
        bar.BackgroundColor3=Color3.fromRGB(80,80,80); Instance.new("UICorner",bar)
        local fill=Instance.new("Frame",bar)
        fill.Size=UDim2.new((default-range.min)/(range.max-range.min),0,1,0); fill.BackgroundColor3=Color3.new(1,1,1); Instance.new("UICorner",fill)
        local thumb=Instance.new("Frame",bar)
        thumb.Size=UDim2.new(0,16,1,0); thumb.Position=UDim2.new(fill.Size.X.Scale,0,0,0)
        thumb.AnchorPoint=Vector2.new(0.5,0); thumb.BackgroundColor3=Color3.fromRGB(200,200,200); Instance.new("UICorner",thumb)
        local dragging=false
        thumb.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
        thumb.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                local x=(i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X
                x=math.clamp(x,0,1)
                fill.Size=UDim2.new(x,0,1,0)
                thumb.Position=UDim2.new(x,0,0,0)
                local v=math.floor(range.min+x*(range.max-range.min))
                lbl.Text=text.." ("..v..")"
                cb(v)
            end
        end)
        return section
    end
    function section:AddTextbox(placeholder, default, cb)
        local row=Instance.new("Frame", frame)
        row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local box=Instance.new("TextBox",row)
        box.PlaceholderText=placeholder; box.Text=default or ""
        box.Font=Enum.Font.Gotham; box.TextSize=16; box.TextColor3=Color3.new(1,1,1)
        box.Size=UDim2.new(1,0,0,28); box.Position=UDim2.new(0,0,0,2)
        box.BackgroundColor3=Color3.fromRGB(80,80,80)
        Instance.new("UICorner",box); Instance.new("UIStroke",box).Color=Color3.fromRGB(100,100,100)
        box.FocusLost:Connect(function(enter) if enter then cb(box.Text) end end)
        return section
    end
    function section:AddColorPicker(text, default, cb)
        section:AddButton(text, function()
            -- simple toggle demonstration
            cb(default)
        end)
        return section
    end
    function section:AddDropdown(text, items, cb)
        section:AddButton(text, function()
            cb(items[1])
        end)
        return section
    end
    function section:AddKeybind(text, default, cb)
        local row=Instance.new("Frame", frame)
        row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row)
        lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(0.6,0,1,0)
        local btn=Instance.new("TextButton",row)
        btn.Text=tostring(default); btn.Font=Enum.Font.Gotham; btn.TextSize=16; btn.TextColor3=Color3.new(1,1,1)
        btn.Size=UDim2.new(0,100,0,28); btn.Position=UDim2.new(1,-108,0,2)
        btn.AutoButtonColor=false; btn.BackgroundColor3=Color3.fromRGB(80,80,80)
        Instance.new("UICorner",btn); Instance.new("UIStroke",btn).Color=Color3.fromRGB(100,100,100)
        btn.MouseButton1Click:Connect(function()
            btn.Text="..."
            local conn
            conn=UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType==Enum.UserInputType.Keyboard then
                    btn.Text=tostring(input.KeyCode)
                    cb(input.KeyCode)
                    conn:Disconnect()
                end
            end)
        end)
        return section
    end

    btn.MouseButton1Click:Connect(function()
        for _,p in pairs(self._pages) do
            p.Frame.Visible = false
            p.Button.TextColor3 = Color3.fromRGB(200,200,200)
        end
        frame.Visible = true
        btn.TextColor3 = Color3.fromRGB(16,241,0)
    end)
    if #self._sidebar:GetChildren()==1 then
        btn:MouseButton1Click()
    end

    self._pages[name] = {Button = btn, Frame = frame, Section = section}
    return self._pages[name]
end

function Library:ApplyConfig(cfg)
    for k,v in pairs(cfg) do
        self._config[k] = v
    end
end

function Library.CreateNoti(opts)
    opts.Title    = opts.Title or ""
    opts.Desc     = opts.Desc or ""
    opts.Duration = opts.Duration or 3

    local gui = Instance.new("ScreenGui", PlayerGui)
    gui.Name = "ProjectLunarNoti"
    local cont = Instance.new("Frame", gui)
    cont.AnchorPoint = Vector2.new(1,1)
    cont.Position = UDim2.new(1,-8,1,-8)
    cont.Size = UDim2.new(0,300,0,0)
    cont.BackgroundTransparency = 1

    local nf = Instance.new("Frame", cont)
    nf.Size = UDim2.new(1,0,0,0)
    nf.Position = UDim2.new(0,0,0,nf.Size.Y.Offset)
    nf.BackgroundColor3 = Color3.fromRGB(35,35,35)
    Instance.new("UICorner", nf)
    Instance.new("UIStroke", nf).Color = Color3.fromRGB(100,100,100)

    local t1 = Instance.new("TextLabel", nf)
    t1.Text = opts.Title
    t1.Font = Enum.Font.GothamBold
    t1.TextSize = 18
    t1.TextColor3 = Color3.new(1,1,1)
    t1.BackgroundTransparency = 1
    t1.Position = UDim2.new(0,8,0,8)
    t1.Size = UDim2.new(1,-16,0,24)

    local t2 = Instance.new("TextLabel", nf)
    t2.Text = opts.Desc
    t2.Font = Enum.Font.Gotham
    t2.TextSize = 14
    t2.TextColor3 = Color3.fromRGB(200,200,200)
    t2.BackgroundTransparency = 1
    t2.Position = UDim2.new(0,8,0,32)
    t2.Size = UDim2.new(1,-16,0,18)

    local h = 8+24+4+18+8
    nf:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.3,true)
    nf:TweenPosition(UDim2.new(0,0,0,0),"Out","Quad",0.3,true)

    delay(opts.Duration, function()
        nf:TweenPosition(UDim2.new(0,0,0,h),"Out","Quad",0.3,true)
        wait(0.3)
        gui:Destroy()
    end)
end

return Library
