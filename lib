-- ProjectLunarUI.lua
-- ModuleScript under ReplicatedStorage

local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players          = game:GetService("Players")
local HttpService      = game:GetService("HttpService")
local LocalPlayer      = Players.LocalPlayer
local PlayerGui        = LocalPlayer:WaitForChild("PlayerGui")

local Library = {}
Library._pages = {}
Library._controls = {}
Library._config = {}

-- helper: tween
local function tween(inst, props, dur)
    return TweenService:Create(inst, TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
end

-- Create main window and auto-generate Config tab
function Library.CreateMain(opts)
    assert(opts.Title, "Title required")
    opts.Desc = opts.Desc or ""
    
    -- ScreenGui
    local screen = Instance.new("ScreenGui", PlayerGui)
    screen.Name = "ProjectLunarUI"
    screen.ResetOnSpawn = false
    Library._screen = screen

    -- Main frame
    local main = Instance.new("Frame", screen)
    main.Name = "Main"
    main.Size = UDim2.new(0, 640, 0, 440)
    main.Position = UDim2.new(0.5, -320, 0.5, -220)
    main.BackgroundColor3 = Color3.fromRGB(30,30,30)
    Instance.new("UICorner", main).CornerRadius = UDim.new(0,8)
    Instance.new("UIStroke", main).Color = Color3.fromRGB(100,100,100)
    Library._main = main

    -- TitleBar
    local titleBar = Instance.new("Frame", main)
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1,0,0,48)
    titleBar.BackgroundTransparency = 1

    -- Icon
    local icon = Instance.new("ImageLabel", titleBar)
    icon.Name = "Icon"
    icon.Size = UDim2.new(0,32,0,32)
    icon.Position = UDim2.new(0,12,0,8)
    icon.Image = opts.Icon or "rbxassetid://0"
    icon.BackgroundTransparency = 1

    -- Title
    local titleLbl = Instance.new("TextLabel", titleBar)
    titleLbl.Text = opts.Title
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 22
    titleLbl.TextColor3 = Color3.new(1,1,1)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0,52,0,8)
    titleLbl.Size = UDim2.new(0,300,0,24)

    -- Desc
    local descLbl = Instance.new("TextLabel", titleBar)
    descLbl.Text = opts.Desc
    descLbl.Font = Enum.Font.Gotham
    descLbl.TextSize = 14
    descLbl.TextColor3 = Color3.fromRGB(180,180,180)
    descLbl.BackgroundTransparency = 1
    descLbl.Position = UDim2.new(0,52,0,30)
    descLbl.Size = UDim2.new(0,300,0,14)

    -- Draggable
    do
        local dragging, dragInput, dragStart, startPos
        titleBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = i.Position
                startPos = main.Position
                i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then dragging=false end end)
            end
        end)
        titleBar.InputChanged:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseMovement then dragInput=i end end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i==dragInput then
                local delta = i.Position - dragStart
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X,
                                           startPos.Y.Scale, startPos.Y.Offset+delta.Y)
            end
        end)
    end

    -- Sidebar & Content
    local sidebar = Instance.new("Frame", main)
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0,120,1,-48)
    sidebar.Position = UDim2.new(0,0,0,48)
    sidebar.BackgroundTransparency = 1
    Instance.new("UIListLayout", sidebar).Padding = UDim.new(0,4)
    Library._sidebar = sidebar

    local content = Instance.new("Frame", main)
    content.Name = "Content"
    content.Size = UDim2.new(1,-120,1,-48)
    content.Position = UDim2.new(0,120,0,48)
    content.BackgroundTransparency = 1
    Library._content = content

    -- Generate Config tab
    Library:AddPage("Config")
    local cfgPage = Library._pages["Config"].frame
    local cfgSec = Library._pages["Config"].sections[1]
    -- Export config button
    Library._exportBtn = cfgSec:AddButton("Copy Config", function()
        local json = HttpService:JSONEncode(Library._config)
        if setclipboard then setclipboard(json) end
        print("Config JSON copied:", json)
    end)
    -- Import textbox
    Library._importBox = cfgSec:AddTextbox("Paste JSON here", "", function(txt)
        local ok, data = pcall(function() return HttpService:JSONDecode(txt) end)
        if ok then
            Library:ApplyConfig(data)
            print("Config applied!")
        else
            warn("Invalid JSON")
        end
    end)
    return Library
end

-- Add page
function Library:AddPage(name)
    -- tab button
    local btn = Instance.new("TextButton", Library._sidebar)
    btn.Text=name; btn.Font=Enum.Font.Gotham; btn.TextSize=16; btn.TextColor3=Color3.fromRGB(200,200,200)
    btn.BackgroundTransparency=1; btn.Size=UDim2.new(1,0,0,32)
    -- page frame
    local frame=Instance.new("Frame", Library._content)
    frame.Name=name; frame.Size=UDim2.new(1,0,1,0); frame.BackgroundTransparency=1; frame.Visible=false
    -- section
    local sec=Library:AddSectionInternal(frame, name)
    Library._pages[name]={button=btn, frame=frame, sections={sec}}
    -- click
    btn.MouseButton1Click:Connect(function()
        for _,p in pairs(Library._pages) do p.frame.Visible=false; p.button.TextColor3=Color3.fromRGB(200,200,200) end
        frame.Visible=true; btn.TextColor3=Color3.fromRGB(16,241,0)
    end)
    if (#Library._sidebar:GetChildren()==1) then btn:MouseButton1Click() end
    return Library._pages[name]
end

-- internal section helper
function Library:AddSectionInternal(frame, title)
    local sec=Instance.new("Frame", frame); sec.Size=UDim2.new(1,0,0,0); sec.BackgroundTransparency=1
    local lbl=Instance.new("TextLabel", sec); lbl.Text=title; lbl.Font=Enum.Font.GothamBold; lbl.TextSize=18
    lbl.TextColor3=Color3.new(1,1,1); lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,8,0,8); lbl.Size=UDim2.new(1,-16,0,24)
    local cont=Instance.new("Frame", sec); cont.Name="Container"; cont.Position=UDim2.new(0,8,0,40); cont.Size=UDim2.new(1,-16,0,0); cont.BackgroundTransparency=1
    Instance.new("UIListLayout", cont).Padding=UDim.new(0,8)
    -- auto resize
    cont:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        sec.Size=UDim2.new(1,0,0,48+cont.AbsoluteSize.Y)
    end)
    local section={frame=sec, container=cont, items={}}
    table.insert(Library._pages[title] and Library._pages[title].sections or Library._pages[title],section)
    return section
end

-- control definitions
local function registerControl(section,name,value)
    Library._config[name]=value
end

function Library._AddCommonProps(ctrl,name)
    Library._controls[name]=ctrl
    -- initialize config
    Library._config[name]=ctrl:GetValue and ctrl:GetValue() or nil
end

-- AddButton
function Library._AddButton(section)
    return function(text, callback)
        local b=Instance.new("TextButton", section.container)
        b.Text=text; b.Font=Enum.Font.Gotham; b.TextSize=16; b.TextColor3=Color3.new(1,1,1)
        b.BackgroundColor3=Color3.fromRGB(80,80,80); b.Size=UDim2.new(1,0,0,32)
        Instance.new("UICorner",b); Instance.new("UIStroke",b).Color=Color3.fromRGB(100,100,100)
        b.MouseEnter:Connect(function() tween(b,{BackgroundColor3=Color3.fromRGB(100,100,100)}) end)
        b.MouseLeave:Connect(function() tween(b,{BackgroundColor3=Color3.fromRGB(80,80,80)}) end)
        b.MouseButton1Click:Connect(callback)
        return section
    end
end

-- AddToggle
function Library._AddToggle(section)
    return function(text,default,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row); lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(0.7,0,1,0)
        -- switch
        local sw=Instance.new("TextButton",row); sw.Size=UDim2.new(0,50,0,28); sw.Position=UDim2.new(1,-58,0,2)
        sw.AutoButtonColor=false; sw.BackgroundColor3=Color3.fromRGB(80,80,80); Instance.new("UICorner",sw)
        local knob=Instance.new("Frame",sw); knob.Size=UDim2.new(0,24,1,0); knob.Position=UDim2.new(default and 1 or 0,default and -24 or 0,0,0)
        knob.BackgroundColor3=Color3.new(1,1,1); Instance.new("UICorner",knob)
        local state=default
        sw.MouseButton1Click:Connect(function()
            state=not state
            tween(knob,{Position=UDim2.new(state and 1 or 0,state and -24 or 0,0,0)})
            registerControl(nil,text,state)
            callback(state)
        end)
        registerControl(nil,text,default)
        return section
    end
end

-- AddSlider
function Library._AddSlider(section)
    return function(text,default,range,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,48); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row); lbl.Text=text.." ("..default..")"; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16
        lbl.TextColor3=Color3.new(1,1,1); lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(1,0,0,20)
        local bar=Instance.new("Frame",row); bar.Position=UDim2.new(0,0,0,24); bar.Size=UDim2.new(1,0,0,8)
        bar.BackgroundColor3=Color3.fromRGB(80,80,80); Instance.new("UICorner",bar)
        local fill=Instance.new("Frame",bar); fill.Size=UDim2.new((default-range.min)/(range.max-range.min),0,1,0); fill.BackgroundColor3=Color3.new(1,1,1); Instance.new("UICorner",fill)
        local thumb=Instance.new("Frame",bar); thumb.Size=UDim2.new(0,16,1,0); thumb.Position=UDim2.new(fill.Size.X.Scale,0,0,0)
        thumb.AnchorPoint=Vector2.new(0.5,0); thumb.BackgroundColor3=Color3.fromRGB(200,200,200); Instance.new("UICorner",thumb)
        local dragging=false
        thumb.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
        thumb.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                local x=(i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X
                x=math.clamp(x,0,1)
                fill.Size=UDim2.new(x,0,1,0)
                thumb.Position=UDim2.new(x,0,0,0)
                local val=math.floor(range.min+x*(range.max-range.min))
                lbl.Text=text.." ("..val..")"
                registerControl(nil,text,val)
                callback(val)
            end
        end)
        registerControl(nil,text,default)
        return section
    end
end

-- AddColorPicker
function Library._AddColorPicker(section)
    return function(text,default,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row); lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(0.7,0,1,0)
        local box=Instance.new("Frame",row); box.Size=UDim2.new(0,32,0,32); box.Position=UDim2.new(1,-40,0,0)
        box.BackgroundColor3=default; Instance.new("UICorner",box)
        local chooser=false; local picker
        local function openPicker()
            if picker then picker:Destroy(); picker=nil; return end
            picker=Instance.new("Frame",row); picker.Size=UDim2.new(0,200,0,200); picker.Position=UDim2.new(1,10,0,0)
            picker.BackgroundColor3=Color3.fromRGB(40,40,40); Instance.new("UICorner",picker)
            -- R,G,B sliders
            local y=8
            for i,comp in ipairs({"R","G","B"}) do
                local sl=Library._AddSlider({container=picker})(comp, default[comp:lower()]*255, {min=0,max=255}, function(v)
                    local col=Color3.new(
                        comp=="R" and v/255 or box.BackgroundColor3.R,
                        comp=="G" and v/255 or box.BackgroundColor3.G,
                        comp=="B" and v/255 or box.BackgroundColor3.B)
                    box.BackgroundColor3=col
                    registerControl(nil,text,col)
                    callback(col)
                end)
                sl.container.Position=UDim2.new(0,8,0,y);
                y=y+56
            end
        end
        box.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then openPicker() end
        end)
        registerControl(nil,text,default)
        return section
    end
end

-- AddDropdown
function Library._AddDropdown(section)
    return function(text,items,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row); lbl.Text=text; lbl.Font=Enum.Font.Gotham; lbl.TextSize=16; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,0,0,0); lbl.Size=UDim2.new(0.5,0,1,0)
        local btn=Instance.new("TextButton",row); btn.Text="Select"; btn.Font=Enum.Font.Gotham; btn.TextSize=16; btn.TextColor3=Color3.new(1,1,1)
        btn.Size=UDim2.new(0,100,0,28); btn.Position=UDim2.new(1,-108,0,2); btn.AutoButtonColor=false; btn.BackgroundColor3=Color3.fromRGB(80,80,80)
        Instance.new("UICorner",btn); Instance.new("UIStroke",btn).Color=Color3.fromRGB(100,100,100)
        local list
        local function toggleList()
            if list then list:Destroy(); list=nil; return end
            list=Instance.new("Frame",row); list.Size=UDim2.new(0,100,0,#items*28); list.Position=UDim2.new(1,-108,0,32)
            list.BackgroundColor3=Color3.fromRGB(50,50,50); Instance.new("UICorner",list)
            for i,v in ipairs(items) do
                local opt=Instance.new("TextButton",list)
                opt.Text=v; opt.Font=Enum.Font.Gotham; opt.TextSize=16; opt.TextColor3=Color3.new(1,1,1)
                opt.Size=UDim2.new(1,0,0,28); opt.Position=UDim2.new(0,0,0,(i-1)*28); opt.BackgroundTransparency=1
                opt.MouseButton1Click:Connect(function()
                    btn.Text=v; callback(v); registerControl(nil,text,v); toggleList()
                end)
            end
        end
        btn.MouseButton1Click:Connect(toggleList)
        registerControl(nil,text,btn.Text)
        return section
    end
end

-- AddTextbox
function Library._AddTextbox(section)
    return function(placeholder,default,callback)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,32); row.BackgroundTransparency=1
        local box=Instance.new("TextBox",row)
        box.PlaceholderText=placeholder; box.Text=default or ""
        box.Font=Enum.Font.Gotham; box.TextSize=16; box.TextColor3=Color3.new(1,1,1)
        box.Size=UDim2.new(1,0,0,28); box.Position=UDim2.new(0,0,0,2)
        box.BackgroundColor3=Color3.fromRGB(80,80,80)
        Instance.new("UICorner",box); Instance.new("UIStroke",box).Color=Color3.fromRGB(100,100,100)
        box.FocusLost:Connect(function(enter) if enter then callback(box.Text); registerControl(nil,placeholder,box.Text) end end)
        registerControl(nil,placeholder,default)
        return section
    end
end

-- AddParagraph
function Library._AddParagraph(section)
    return function(text,content)
        local row=Instance.new("Frame",section.container); row.Size=UDim2.new(1,0,0,0); row.BackgroundTransparency=1
        local lbl=Instance.new("TextLabel",row)
        lbl.Text=text; lbl.Font=Enum.Font.GothamBold; lbl.TextSize=18; lbl.TextColor3=Color3.new(1,1,1)
        lbl.BackgroundTransparency=1; lbl.Position=UDim2.new(0,8,0,8); lbl.Size=UDim2.new(1,-16,0,24)
        local cont=Instance.new("TextLabel",row)
        cont.Text=content; cont.Font=Enum.Font.Gotham; cont.TextSize=14; cont.TextColor3=Color3.fromRGB(200,200,200)
        cont.BackgroundTransparency=1; cont.Position=UDim2.new(0,8,0,40); cont.Size=UDim2.new(1,-16,0,0)
